<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p>Cargando autorización...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <div class="d-flex flex-column align-items-center justify-content-center vh-100 bg-light text-center">
                    <h1 class="display-1 fw-bold text-secondary">404</h1>
                    <h2 class="mb-3 text-dark">Página no encontrada</h2>
                    <p class="text-muted mb-4">Lo sentimos, la ruta que intentas buscar no existe o no está disponible.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>