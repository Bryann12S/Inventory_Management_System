@page "/products/new"
@page "/products/edit/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">@(Id.HasValue ? "Editar Producto" : "Registrar Nuevo Producto")</h4>
        </div>
        <div class="card-body">
            <EditForm Model="@productModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-bold">Nombre del Producto</label>
                    <InputText @bind-Value="productModel.Name" class="form-control" placeholder="Ej. Laptop HP Pro" />
                    <ValidationMessage For="@(() => productModel.Name)" class="text-danger small" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">SKU (Código Único)</label>
                        <InputText @bind-Value="productModel.SKU" class="form-control" placeholder="Ej. PROD-1234" disabled="@Id.HasValue" />
                        <ValidationMessage For="@(() => productModel.SKU)" class="text-danger small" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Categoría</label>
                        <InputText @bind-Value="productModel.Category" class="form-control" placeholder="Ej. Tecnología" />
                        <ValidationMessage For="@(() => productModel.Category)" class="text-danger small" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Precio Unitario ($)</label>
                        <InputNumber @bind-Value="productModel.UnitPrice" class="form-control" step="0.01" />
                        <ValidationMessage For="@(() => productModel.UnitPrice)" class="text-danger small" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Stock Inicial</label>
                        <InputNumber @bind-Value="productModel.QuantityStock" class="form-control" />
                        <ValidationMessage For="@(() => productModel.QuantityStock)" class="text-danger small" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger small">@errorMessage</div>
                }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                        @(isSubmitting ? "Guardando..." : "Guardar Producto")
                    </button>
                    <button type="button" class="btn btn-outline-secondary w-100" @onclick="Cancel">
                        Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private NewProductForm productModel = new();
    private string? errorMessage;
    private bool isSubmitting = false;
    private bool isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            isLoading = true;
            errorMessage = null;
            try
            {
    
                var token = await LocalStorage.GetItemAsync<string>("authToken");
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

                var product = await Http.GetFromJsonAsync<frontend.Models.ProductDto>($"api/products/{Id.Value}");
                if (product != null)
                {
                    productModel = new NewProductForm
                    {
                        Name = product.Name,
                        SKU = product.SKU,
                        Category = product.Category,
                        QuantityStock = product.QuantityInStock, 
                        UnitPrice = product.UnitPrice
                    };
                }
            }
            catch (Exception ex)
            {
                errorMessage = "Error al cargar el producto: " + ex.Message;
            }
            finally
            {
                Http.DefaultRequestHeaders.Authorization = null;
                isLoading = false;
            }
        }
        else
        {
            productModel = new NewProductForm();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            HttpResponseMessage response;

            if (Id.HasValue)
            {
                // Mood edit
                response = await Http.PutAsJsonAsync($"api/products/{Id.Value}", new {
                    Id = Id.Value,
                    productModel.Name,
                    productModel.SKU,
                    productModel.Category,
                    productModel.QuantityStock,
                    productModel.UnitPrice
                });
            }
            else
            {
                // Mood create
                response = await Http.PostAsJsonAsync("api/products", productModel);
            }

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Sesión expirada o no autorizada. Intenta iniciar sesión nuevamente.";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = "Error del servidor: " + errorContent;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error de red: " + ex.Message;
        }
        finally
        {
            Http.DefaultRequestHeaders.Authorization = null;
            isSubmitting = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/");

    public class NewProductForm
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede exceder los 100 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "El SKU es obligatorio.")]
        [StringLength(50, ErrorMessage = "El SKU no puede exceder los 50 caracteres.")]
        public string SKU { get; set; } = string.Empty;

        [Required(ErrorMessage = "La categoría es obligatoria.")]
        [StringLength(50, ErrorMessage = "La categoría no puede exceder los 50 caracteres.")]
        public string Category { get; set; } = string.Empty;

        [Required(ErrorMessage = "El stock inicial es obligatorio.")]
        [Range(0, int.MaxValue, ErrorMessage = "El stock no puede ser negativo.")]
        public int QuantityStock { get; set; } = 0;

        [Required(ErrorMessage = "El precio es obligatorio.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "El precio debe ser mayor a 0.")]
        public decimal UnitPrice { get; set; } = 0.00m;
    }
}