@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using frontend.Models
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="d-flex justify-content-between align-content-center mb-4">
        <h2>Gestión de Inventario</h2>
        <a href="/products/new" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Producto
        </a>
        
    </div>

    <div class="card mb-4 bg-light">
        <div class="card-body row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-bold">Filtrar por Categoría</label>
                <input type="text" class="form-control" 
                    @bind="categoryFilter" 
                    @bind:event="oninput"
                    @onkeyup="HandleKeyUp"
                    placeholder="Ej. Electrónica" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold">Alerta de Stock Bajo (Menor a:)</label>
                <input type="number" class="form-control" 
                    @bind="lowStockThreshold" 
                    placeholder="Ej. 10" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button class="btn btn-secondary w-100" @onclick="LoadProducts">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                    <i class="bi bi-x-circle"></i> Limpiar
                </button>
            </div>
        </div>
    </div>

    @if (products == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando catálogo...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info text-center">No se encontraron productos en el inventario.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>SKU</th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th class="text-end">Precio Unitario</th>
                        <th class="text-center">Stock</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in products)
                    {
                        // Stock low
                        var isLowStock = prod.QuantityInStock < 10;
                        <tr class="@(isLowStock ? "table-danger" : "")">
                            <td><span class="badge bg-secondary font-monospace">@prod.SKU</span></td>
                            <td class="fw-bold">@prod.Name</td>
                            <td>@prod.Category</td>
                            <td class="text-end">$@prod.UnitPrice.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge @(isLowStock ? "bg-danger" : "bg-success")">
                                    @prod.QuantityInStock unidades
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-info me-1" @onclick="() => ViewDetails(prod.Id)">
                                    Ver Detalles
                                </button>
                                <a href="/products/edit/@prod.Id" class="btn btn-sm btn-warning">
                                    Editar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProductDto>? products;
    private string? categoryFilter;
    private int? lowStockThreshold;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        try
        {
            // Build URL filters 
            var queryParams = new List<string>();

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                queryParams.Add($"category={Uri.EscapeDataString(categoryFilter.Trim())}");
            }

            if (lowStockThreshold.HasValue && lowStockThreshold.Value > 0)
            {
                queryParams.Add($"lowStockThreshold={lowStockThreshold.Value}");
            }
            
            var url = "api/products";
            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }

            products = await Http.GetFromJsonAsync<List<ProductDto>>(url);
        }
        catch (Exception)
        {
            products = new List<ProductDto>();
        }
    }

    private async Task ClearFilters()
    {
        categoryFilter = null;
        lowStockThreshold = null;
        await LoadProducts();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadProducts();
        }
    }

    private void ViewDetails(int id)
    {
        Navigation.NavigateTo($"/products/{id}");
    }
}
